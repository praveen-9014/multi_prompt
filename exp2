from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# Load the pre-trained model
model_name = "google/flan-t5-base"

tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForSeq2SeqLM.from_pretrained(model_name)


def generate_text(prompt):
    inputs = tokenizer(prompt, return_tensors="pt")
    outputs = model.generate(
        **inputs,
        max_new_tokens=150
    )
    return tokenizer.decode(
        outputs[0],
        skip_special_tokens=True
    )


# Unstructured FAQ
faq = """
Q: What are the library working hours?
A: The library is open from 8 AM to 8 PM
from Monday to Friday.

Q: Is Wi-Fi available?
A: Yes. Free Wi-Fi is available for all
registered students.

Q: Can students borrow laptops?
A: Yes. Students can borrow laptops for
academic purposes for three days.

Q: Is the library open on Sunday?
A: No. The library is closed on Sundays.
"""

# Create the prompt
prompt = f"""
Extract the following information from the FAQ:
1. Working Hours
2. Wi-Fi Availability
3. Laptop Policy
4. Sunday Availability

Return the answer using this format:
Working Hours:
Wi-Fi:
Laptop Policy:
Sunday:

FAQ:
{faq}
"""

# Generate and display the output
output = generate_text(prompt)

print("EXTRACTED INFORMATION")
print(output)
